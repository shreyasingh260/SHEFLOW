# ============================================================
# SheFlow — Environment Variables Template
# ============================================================
# Copy this file to a local .env or set these as system/shell
# environment variables before starting the backend.
# NEVER commit real credentials to version control.
# ============================================================

# ----- MySQL Database ----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sheflow_db
DB_USER=root
DB_PASS=your_mysql_password_here

# ----- JWT Security ------------------------------------------
# Must be at least 32 characters long and highly random.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# ----- CORS (Frontend Origin) --------------------------------
# Comma-separated list of allowed frontend origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Flora AI (Optional) -----------------------------------
# Leave blank to use the built-in offline RAG fallback engine.
APP_FLORA_AI_API_KEY=
APP_FLORA_AI_API_URL=https://api.openai.com/v1
APP_FLORA_AI_MODEL=gpt-4o-mini
