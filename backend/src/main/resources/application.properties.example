# ============================================================
# SheFlow Backend — Application Properties EXAMPLE
# ============================================================
# This file is safe to commit. It contains no real secrets.
#
# To configure locally:
#   1. Copy this file: cp application.properties.example application.properties
#   2. Set your real values in application.properties (which is gitignored)
#   OR set environment variables: DB_PASS, JWT_SECRET, etc.
# ============================================================

server.port=8080
server.servlet.context-path=/

# MySQL Database Configuration
# Override with environment variables: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:sheflow_db}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASS:CHANGE_ME}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# HikariCP High-Concurrency Pool Tuning (Sized for 1,000 Concurrent Virtual Users)
spring.datasource.hikari.maximum-pool-size=50
spring.datasource.hikari.minimum-idle=20
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.leak-detection-threshold=2000
spring.datasource.hikari.pool-name=SheFlowHikariPool

# Embedded Tomcat High-Throughput Tuning
server.tomcat.threads.max=200
server.tomcat.threads.min-spare=30
server.tomcat.accept-count=1000
server.tomcat.max-connections=10000
server.tomcat.connection-timeout=20000

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Configuration
# REQUIRED: Set JWT_SECRET environment variable to a strong random 32+ character string.
# Generate: openssl rand -base64 48
app.jwt.secret=${JWT_SECRET:CHANGE_ME_USE_ENVIRONMENT_VARIABLE}
app.jwt.expiration-ms=900000
app.jwt.refresh-expiration-ms=604800000

# Spring Boot Actuator & Prometheus Observability
management.endpoints.web.exposure.include=health,info,prometheus,metrics
management.endpoint.health.show-details=always
management.endpoint.health.probes.enabled=true
management.metrics.tags.application=sheflow-backend

# CORS Configuration for React Frontend
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173}

# Flora AI Configuration (Optional - uses offline RAG fallback if not set)
app.flora.ai.api-key=${APP_FLORA_AI_API_KEY:}
app.flora.ai.api-url=${APP_FLORA_AI_API_URL:https://api.openai.com/v1}
app.flora.ai.model=${APP_FLORA_AI_MODEL:gpt-4o-mini}
